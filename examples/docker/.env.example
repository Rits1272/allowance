# Copy to .env and fill in. Keep .env out of the agent's reach.

# What an agent host must send as "Authorization: Bearer ...".
# Generate with: openssl rand -hex 24
ALLOWANCE_TOKEN=

# The LND node, as the container reaches it.
LND_REST_URL=https://host.docker.internal:8080
# A macaroon that can only pay invoices, and the node's TLS certificate.
# Both must be readable by uid 10001 (the daemon's user in the container).
LND_MACAROON_FILE=/path/to/pay-only.macaroon
LND_TLS_CERT_FILE=/path/to/tls.cert

# The owner's rules (default: examples/policy.toml).
# ALLOWANCE_POLICY_FILE=/path/to/policy.toml
